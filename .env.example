# --- HeyPocket ---
# Klucz API: Pocket -> Settings -> Developer -> API Keys (pk_...). Wymagany przy odpytywaniu (bez webhooków)
# POCKET_API_KEY ustawiasz niżej
# Co ile sekund sprawdzać nowe nagrania przez API (0 = wyłączone, tylko webhooki)
POLL_INTERVAL_SEC=60
# Sekret z ustawień webhooka w aplikacji Pocket (Integrations -> Webhook)
POCKET_WEBHOOK_SECRET=
# Klucz API (pk_...)
POCKET_API_KEY=
POCKET_EVENTS=transcription.completed,summary.completed

# --- Co jest komendą ---
# Limit długości nagrania – stosowany tylko gdy REQUIRE_TRIGGER=false. 0 = bez limitu
MAX_DURATION_SEC=180
# Nagranie z Pocket trafia do PMS TYLKO, gdy w pierwszym zdaniu pada hasło (odporne na błędy transkrypcji:
# „XTB news”, „x t b newsy”, „iks te be news”...). Puste = wbudowane warianty „XTB news”.
# Własne hasła po przecinku, np. TRIGGER_PHRASES=xtb news,portfel news
REQUIRE_TRIGGER=true
TRIGGER_PHRASES=

# --- Serwer ---
PORT=8787
HOST=127.0.0.1
WEBHOOK_PATH=/pocket/webhook
# Token do ręcznego endpointu POST /command (np. ze Skrótów iOS). Puste = wyłączone
BRIDGE_TOKEN=

# --- Wykonanie ---
AUTO_PROCESS=true
CLAUDE_BIN=~/.local/bin/claude
CLAUDE_MODEL=
# true = agent może sterować Twoim Chrome (rozszerzenie Claude in Chrome)
USE_CHROME=false
OPEN_REPORT=true
NOTIFY=true
JOB_TIMEOUT_MIN=15

# true = weryfikuj podpis HMAC (gdy znasz sekret Pocketa); false = ochroną jest tajna WEBHOOK_PATH
REQUIRE_SIGNATURE=true

# --- PMS (portfel) ---
# Folder PMS na Dysku Google (Google Drive for desktop), np.:
# PMS_DIR=~/Library/CloudStorage/GoogleDrive-twoj.adres@gmail.com/My Drive/PMS
# Puste = lokalny folder ~/pocket-bridge/pms
PMS_DIR=
# Raporty trafiają do <PMS_DIR>/xtb-news (można nadpisać OUTPUT_DIR=...)
BASE_CURRENCY=PLN
# Poranny brief: godzina (puste = wyłączony) i dni tygodnia (0=nd, 1=pn ... 6=sb)
DAILY_BRIEF_TIME=07:30
DAILY_BRIEF_DAYS=1,2,3,4,5
# Co ile sekund sprawdzać <PMS_DIR>/inbox/xtb w poszukiwaniu nowych maili XTB (0 = wyłączone)
INGEST_INTERVAL_SEC=60
# Model do parsowania maili (puste = domyślny), np. haiku
INGEST_MODEL=
# Skan newsów dla pozycji (alerty, PILNE): co ile minut, w jakich godzinach i dniach. 0 = wyłączony
NEWS_SCAN_INTERVAL_MIN=120
NEWS_SCAN_HOURS=8-21
NEWS_SCAN_DAYS=1,2,3,4,5
